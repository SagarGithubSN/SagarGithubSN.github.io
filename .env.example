# Captain Exim — environment
# Copy to .env.local for development, or set these in your host's dashboard.
# NEVER commit a real .env file. The previous project shipped one inside a zip
# with live database and SMTP credentials in it.

# Public site URL. Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://captainexim.com

# --- Enquiry mail -----------------------------------------------------------
# Without these the site still stores every enquiry, but sends no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Envelope sender, and the mailbox enquiries are delivered to.
MAIL_FROM="Captain Exim <info@captainexim.com>"
ENQUIRY_RECIPIENT=info@captainexim.com

# --- Storage ----------------------------------------------------------------
# Directory for enquiries.db and the enquiries.jsonl fallback.
# Must be writable and, on a container host, backed by a persistent volume.
ENQUIRY_DATA_DIR=

# --- Admin (/admin) ---------------------------------------------------------
# If either is unset, /admin returns 503 rather than opening.
ADMIN_USER=
ADMIN_PASSWORD=
